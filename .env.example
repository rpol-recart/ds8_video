# ── RTSP Camera ───────────────────────────────────────────────
RTSP_URI=rtsp://admin:password@192.168.1.100:554/Streaming/Channels/101

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RESULTS=container-recognition-results
KAFKA_TOPIC_IMAGES=container-recognition-images

# ── Redis (deduplication) ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DEDUP_TTL_SEC=86400

# ── Monitoring ───────────────────────────────────────────────
PROMETHEUS_PORT=8000
LOG_LEVEL=INFO

# ── Detection thresholds ─────────────────────────────────────
CONTAINER_CONFIDENCE_THRESHOLD=0.6
OCR_CONFIDENCE_THRESHOLD=0.7
TRACKER_MAX_AGE=60
